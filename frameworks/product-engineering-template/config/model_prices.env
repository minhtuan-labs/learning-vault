# Model price table — USD per 1,000,000 tokens (input / output)
# v10.24 — consumed by scripts/cost_report.sh
#
# Format (one model per line, no spaces around '='):
#   <model_id>=<input_usd_per_1M>:<output_usd_per_1M>
#
# Notes:
#   - Model IDs must match what appears in config/engines/<engine>.env
#     (the same string passed to the engine's --model flag) and what
#     route_to_pane.sh records in .pane_logs/_routing_receipts.log.
#   - Prices are list prices and DRIFT over time — treat the cost report
#     as an estimate, not an invoice. Update these numbers when your
#     provider changes pricing.
#   - opencode-go free/cheap tiers are listed at 0 (or near-0). If you
#     route a paid provider model (e.g. anthropic/claude-*), add its
#     real price here so the report counts it.
#   - DEFAULT is used for any model not found below. Set it to a
#     conservative non-zero number so unknown models don't silently
#     report as free.

# ---- Anthropic / Claude Code engine ----
claude-haiku-4-5=1.00:5.00
claude-haiku-4-5-20251001=1.00:5.00
claude-sonnet-4-6=3.00:15.00
claude-opus-4-6=15.00:75.00

# ---- OpenCode (opencode-go provider) ----
# These default to 0 — opencode-go tiers used by the template ship as
# free/effectively-free. Override with real numbers if your provider bills.
opencode-go/glm-5.1=0:0
opencode-go/glm-5=0:0
opencode-go/deepseek-v4-flash=0:0
opencode-go/deepseek-v4-pro=0:0
opencode-go/qwen3.6-plus=0:0
opencode-go/qwen3.5-plus=0:0
opencode-go/mimo-v2.5=0:0
opencode-go/kimi-k2.6=0:0
opencode/big-pickle=0:0

# ---- Fallback for any unlisted model ----
DEFAULT=3.00:15.00
