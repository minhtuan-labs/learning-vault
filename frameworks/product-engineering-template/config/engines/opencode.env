# Engine: OpenCode (opencode-go fork)
# v10.12 — pluggable engine abstraction.
#
# Used when start_agents_tmux.sh is invoked with --engine opencode
# (or without an --engine flag, since opencode is the default).
#
# Sourced by:
#   scripts/start_agents_tmux.sh, route_to_pane.sh, run_agent_task.sh,
#   check_models.sh, answer_role.sh

# ---- Engine identity / dispatch ----
ENGINE_NAME="opencode"
ENGINE_BINARY="opencode"
ENGINE_TUI_LAUNCH="opencode"              # interactive TUI launch (no extra args, --model added by scripts)
ENGINE_RUN_BASE="opencode run"            # non-interactive single-shot
ENGINE_MODEL_FLAG="--model"
ENGINE_CONFIG_ENV_VAR="OPENCODE_CONFIG"   # if non-empty, scripts export this var = config path
ENGINE_CONFIG_PATH=".opencode/config.json"
ENGINE_AUTO_CONTEXT_FILE="AGENTS.md"      # opencode auto-loads AGENTS.md at session start

# ---- Model validation mode ----
# "dynamic"  → call `opencode models` at startup and grep for each role's model
# "static"   → check binary in PATH, then validate model strings against ENGINE_KNOWN_MODELS
ENGINE_MODEL_CHECK_MODE="dynamic"
ENGINE_MODELS_LIST_CMD="opencode models"

# ---- Per-role model IDs (opencode-go provider) ----
# Mix-and-match across cost tiers: free/cheap for low-stakes roles,
# strong models where it matters (SA / BE / FE / Orchestrator).
ORCHESTRATOR_MODEL="opencode-go/glm-5.1"
PM_MODEL="opencode-go/deepseek-v4-flash"
SA_MODEL="opencode-go/deepseek-v4-pro"
BA_MODEL="opencode-go/qwen3.6-plus"
UX_MODEL="opencode-go/mimo-v2.5"
BE_MODEL="opencode-go/deepseek-v4-pro"
FE_MODEL="opencode-go/kimi-k2.6"
QA_MODEL="opencode-go/qwen3.5-plus"
DELIVERY_MODEL="opencode-go/glm-5"
