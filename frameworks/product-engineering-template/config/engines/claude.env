# Engine: Claude Code (Anthropic CLI)
# v10.12 — pluggable engine abstraction.
#
# Used when start_agents_tmux.sh is invoked with --engine claude.
# Sourced by the same scripts as opencode.env (see config/engines/README.md).

# ---- Engine identity / dispatch ----
ENGINE_NAME="claude"
ENGINE_BINARY="claude"
ENGINE_TUI_LAUNCH="claude"                # interactive Claude Code TUI
ENGINE_RUN_BASE="claude --print"          # non-interactive single-shot (--print exits after response)
ENGINE_MODEL_FLAG="--model"
ENGINE_CONFIG_ENV_VAR=""                  # Claude Code auto-loads .claude/settings.json from CWD
ENGINE_CONFIG_PATH=".claude/settings.json"
ENGINE_AUTO_CONTEXT_FILE="CLAUDE.md"      # Claude Code's preferred context file (auto-loaded)

# ---- Model validation mode ----
# Claude Code has no `claude models` subcommand → use static whitelist.
ENGINE_MODEL_CHECK_MODE="static"
ENGINE_KNOWN_MODELS="claude-haiku-4-5 claude-sonnet-4-6 claude-opus-4-6 claude-haiku-4-5-20251001"

# ---- Per-role model IDs (Claude Code) ----
# Claude only has 3 tiers (haiku / sonnet / opus). Mapping is coarser
# than opencode's 7-tier setup but follows the same intent: cheap for
# planning/review roles, strong for architecture and implementation.
ORCHESTRATOR_MODEL="claude-sonnet-4-6"     # balanced router; not the cheapest because Orchestrator drives every turn
PM_MODEL="claude-haiku-4-5"                # planning, fast & cheap
SA_MODEL="claude-opus-4-6"                 # architecture / tech stack — invest here
BA_MODEL="claude-haiku-4-5"                # business rules; cheap
UX_MODEL="claude-haiku-4-5"                # UX flow; cheap
BE_MODEL="claude-opus-4-6"                 # backend code — invest here
FE_MODEL="claude-sonnet-4-6"               # frontend code; balanced
QA_MODEL="claude-haiku-4-5"                # test plan; cheap
DELIVERY_MODEL="claude-haiku-4-5"          # Docker/compose; cheap
