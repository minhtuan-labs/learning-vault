# macOS noise
.DS_Store
._*
.AppleDouble
.LSOverride

# Editor noise
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Generated by scripts/start_agents_tmux.sh, route_to_pane.sh,
# ask_orchestrator.sh, answer_role.sh
# (per-project runtime artifacts — never commit these)
.agent_panes
.agent_session
.agent_session_mode
.agent_boot_prompts/
.agent_tasks/
.agent_logs/
.pane_tasks/
.pane_logs/
.pane_questions/
.pane_answers/
.pane_notifications/
.pane_watches/
.pane_heartbeats/
.watcher.pid
.framework_sync_backup/

# v10.19 — Auto-generated PATH-guard wrappers for the Orchestrator pane.
# Only the shared blocker is committed; per-command wrappers are
# regenerated by start_agents_tmux.sh every session.
scripts/guards/*
!scripts/guards/_block_orchestrator.sh

# NOTE: memory/ is INTENTIONALLY NOT IGNORED. It is the team's durable
# cross-session memory and must be committed so tomorrow's session can
# resume from yesterday's decisions.

# Logs / scratch
*.log
.tmp/
.cache/

# OpenCode local state (per-project, may contain secrets)
# Note: .opencode/config.json IS committed because it defines the policy.
.opencode/cache/
.opencode/state/
.opencode/auth/
.opencode/*.local.json

# Secrets — never commit these
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key

# Node / Python / etc. (in case BE/FE/QA panes produce code)
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# Backups
*.bak
*.orig
*~
