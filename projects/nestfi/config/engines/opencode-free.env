# Engine: OpenCode — FREE-tier overlay
# v10.16.4 — hardcoded to `opencode/big-pickle`, confirmed working in
# this opencode-go fork.
#
# Sourced by start_agents_tmux.sh AFTER opencode.env when the user
# passes --free. Overrides every <ROLE>_MODEL.
#
# ============================================================================
# OVERRIDE
# ============================================================================
# To use a different free model for this session, set OPENCODE_FREE_MODEL
# in your shell before running start_agents_tmux.sh:
#
#   OPENCODE_FREE_MODEL='opencode/some-other-free-id' \
#     bash scripts/start_agents_tmux.sh nestfi --engine opencode --free
#
# To discover what other free IDs your fork exposes:
#
#   bash scripts/list_free_models.sh
# ============================================================================

# Default — confirmed working free model in opencode-go.
_FREE_MODEL="${OPENCODE_FREE_MODEL:-opencode/big-pickle}"

# All 9 roles share the same free model — workflow correctness does
# not require diversity, only a reachable model.
ORCHESTRATOR_MODEL="$_FREE_MODEL"
PM_MODEL="$_FREE_MODEL"
SA_MODEL="$_FREE_MODEL"
BA_MODEL="$_FREE_MODEL"
UX_MODEL="$_FREE_MODEL"
BE_MODEL="$_FREE_MODEL"
FE_MODEL="$_FREE_MODEL"
QA_MODEL="$_FREE_MODEL"
DELIVERY_MODEL="$_FREE_MODEL"

# Relax strict model check — free-tier availability changes between
# session boots in some forks, so we don't want a refusal-to-launch
# over transient catalogue churn.
STRICT_MODEL_CHECK="${STRICT_MODEL_CHECK_FREE_OVERRIDE:-false}"
