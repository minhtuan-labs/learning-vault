# OpenCode runtime configuration — v10.1
#
# v10.1 fix vs v10.0:
#   - Removed --config CLI flag from all opencode invocations because the
#     opencode-go fork does not accept it and exits with an error, which
#     caused the Orchestrator pane to crash back to bash and (combined with
#     the auto-paste of the boot prompt) get stuck at  dquote>.
#   - Instead we rely on:
#       (a) OPENCODE_CONFIG env var — file path to the JSON config
#       (b) Project-root auto-load of .opencode/config.json and opencode.json
#       (c) AGENTS.md — auto-loaded role-aware system instructions
#   - Removed the racy auto-paste of the boot prompt. If you need to inject
#     the boot prompt manually after the TUI is loaded, run:
#         bash scripts/inject_boot_prompt.sh ORCHESTRATOR

AUTO_START_ORCHESTRATOR=true
AUTO_START_WORKER_AGENTS=false

OPENCODE_PROVIDER=opencode-go
STRICT_MODEL_CHECK=true

# Worker task execution mode:
#   run  = use `opencode run` non-interactive. Recommended.
#   tui  = use interactive `opencode`. Not recommended for workers.
WORKER_OPENCODE_MODE=run

OPENCODE_EXTRA_ARGS=""

SHOW_AGENT_BANNER=true

# The real subagent disabling lives in .opencode/config.json (and AGENTS.md).
DENY_INTERNAL_TASK_TOOL=true

# v10.4: when a worker calls ask_orchestrator.sh or notify_orchestrator.sh,
# inject a one-line [INBOX] message into the Orchestrator's TUI and press
# Enter, so OpenCode processes the new question/notification immediately
# instead of sitting idle until the user types something. Set to false if
# you find the auto-submit too disruptive while typing (the inbox is still
# updated on disk; you'd just need to ask "any pending?" manually).
AUTO_PING_ORCHESTRATOR=true
